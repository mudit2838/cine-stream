# Server-only: never prefix secrets with NEXT_PUBLIC_.
TMDB_API_KEY=
# Alternatively use a TMDB API Read Access Token:
TMDB_ACCESS_TOKEN=
# Optional, enables the retained AI Mood Matcher:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to the canonical deployment URL after deploying:
SITE_URL=http://localhost:3000
